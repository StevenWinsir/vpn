<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- One accent colour, reserved for the primary action (handoff section 9.1). Status is always text as well as colour. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6FEB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2559C4" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F6F8FB" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DDE3EC" />
    <SolidColorBrush x:Key="TextBrush" Color="#1B2430" />
    <SolidColorBrush x:Key="MutedBrush" Color="#5B6675" />
    <SolidColorBrush x:Key="PassBrush" Color="#1F7A4D" />
    <SolidColorBrush x:Key="FailBrush" Color="#B3261E" />
    <SolidColorBrush x:Key="WarnBrush" Color="#8A5300" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#EAF1FE" />
    <SolidColorBrush x:Key="ButtonBrush" Color="#EEF2F8" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#E1E8F2" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#EEF2F8" />
</ResourceDictionary>
