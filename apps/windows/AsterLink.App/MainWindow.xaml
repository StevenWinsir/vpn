<Window x:Class="AsterLink.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AsterLink.App.Views"
        Icon="Assets/AsterLink.ico"
        Title="AsterLink" Width="1000" Height="680" MinWidth="800" MinHeight="560"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <!-- Entry state: service setup, e-mail, password, remember. -->
        <views:LoginView Visibility="{Binding ShowLogin, Converter={StaticResource BoolToVisibility}}" />

        <!-- Signed in: exactly three pages. -->
        <Grid Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,20,12,16" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Top" Text="AsterLink" FontSize="20" FontWeight="SemiBold" Margin="8,0,0,20" />
                    <RadioButton DockPanel.Dock="Top" Content="连接" Style="{StaticResource NavItem}" GroupName="nav"
                                 IsChecked="{Binding PageConnect}" AutomationProperties.AutomationId="NavConnect" />
                    <RadioButton DockPanel.Dock="Top" Content="线路" Style="{StaticResource NavItem}" GroupName="nav"
                                 IsChecked="{Binding PageNodes}" AutomationProperties.AutomationId="NavNodes" />
                    <RadioButton DockPanel.Dock="Top" Content="账户与设置" Style="{StaticResource NavItem}" GroupName="nav"
                                 IsChecked="{Binding PageSettings}" AutomationProperties.AutomationId="NavSettings" />

                    <StackPanel DockPanel.Dock="Bottom" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{Binding SidebarStatusBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SidebarStatus}" Margin="8,0,0,0" FontWeight="SemiBold"
                                       AutomationProperties.AutomationId="SidebarStatus" />
                        </StackPanel>
                        <TextBlock Text="{Binding UserEmail}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="管理员账号" Style="{StaticResource Muted}" FontSize="12"
                                   Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,24,32,24" MaxWidth="760" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,16" BorderBrush="{DynamicResource WarnBrush}"
                            Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Banner}" Foreground="{DynamicResource WarnBrush}" AutomationProperties.AutomationId="Banner" />
                    </Border>
                    <views:ConnectView
                        Visibility="{Binding PageConnect, Converter={StaticResource BoolToVisibility}}" />
                    <views:NodesView
                        Visibility="{Binding PageNodes, Converter={StaticResource BoolToVisibility}}" />
                    <views:SettingsView
                        Visibility="{Binding PageSettings, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
