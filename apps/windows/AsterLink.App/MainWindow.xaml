<Window x:Class="AsterLink.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AsterLink.App.Views"
        xmlns:ui="clr-namespace:AsterLink.App.Controls"
        Icon="Assets/AsterLink.ico"
        Title="AsterLink" Width="1000" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <!-- Entry state: the brand column and the sign-in card (with the background service guide when needed). -->
        <views:LoginView Visibility="{Binding ShowLogin, Converter={StaticResource BoolToVisibility}}" />

        <!-- Signed in: sidebar (brand, three pages, status) and the page. -->
        <Grid Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="Sidebar" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,20,14,18" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,26">
                        <ContentControl Style="{StaticResource BrandMark}" Width="30" Height="30" />
                        <TextBlock Text="AsterLink" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                    </StackPanel>
                    <RadioButton DockPanel.Dock="Top" Content="连接" Style="{StaticResource NavItem}" GroupName="nav" ui:Ui.Icon="{StaticResource IconPower}"
                                 IsChecked="{Binding PageConnect}" AutomationProperties.AutomationId="NavConnect" />
                    <RadioButton DockPanel.Dock="Top" Content="线路" Style="{StaticResource NavItem}" GroupName="nav" ui:Ui.Icon="{StaticResource IconWorld}"
                                 IsChecked="{Binding PageNodes}" AutomationProperties.AutomationId="NavNodes" />
                    <RadioButton DockPanel.Dock="Top" Content="账户" Style="{StaticResource NavItem}" GroupName="nav" ui:Ui.Icon="{StaticResource IconUserCircle}"
                                 IsChecked="{Binding PageSettings}" AutomationProperties.AutomationId="NavSettings" />

                    <StackPanel DockPanel.Dock="Bottom" Margin="4,0,4,0">
                        <!-- Status pill: dot + words, never colour alone. -->
                        <Border CornerRadius="14" Padding="10,6" HorizontalAlignment="Left" Background="{Binding SidebarStatusBackground}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding SidebarStatusBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SidebarStatus}" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap"
                                           Foreground="{Binding SidebarStatusBrush}" AutomationProperties.AutomationId="SidebarStatus" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding UserEmail}" Style="{StaticResource Caption}" Margin="2,10,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   ToolTip="{Binding UserEmail}" />
                        <Border Style="{StaticResource Pill}" Background="{DynamicResource BrandSoftBrush}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="管理员账号" Style="{StaticResource PillText}" Foreground="{DynamicResource BrandBrush}" />
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
                <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="32,26,32,32" MaxWidth="920">
                        <Grid Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" AutomationProperties.AutomationId="PageTitle" />
                                <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource PageSubtitle}"
                                           Visibility="{Binding PageSubtitle, Converter={StaticResource TextToVisibility}}" />
                            </StackPanel>
                            <Button Content="刷新" Style="{StaticResource GhostButton}" ui:Ui.Icon="{StaticResource IconRefresh}" Command="{Binding RefreshCommand}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{Binding PageNodes, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.AutomationId="RefreshNodes" />
                        </Grid>
                        <ui:NoticeBar Text="{Binding Banner}" Kind="warning" Margin="0,0,0,16" AutomationProperties.AutomationId="Banner" />
                        <views:ConnectView Visibility="{Binding PageConnect, Converter={StaticResource BoolToVisibility}}" />
                        <views:LinesView Visibility="{Binding PageNodes, Converter={StaticResource BoolToVisibility}}" />
                        <views:AccountView Visibility="{Binding PageSettings, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
