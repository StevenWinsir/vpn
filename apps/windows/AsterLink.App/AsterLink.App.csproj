<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The platform version is the OS floor: Windows 10 2004 (19041). Windows 10 22H2 (19045) and
         Windows 11 are both above it. Calling an API newer than the floor without a runtime check
         fails the build (CA1416), so nothing Windows 11-only can slip in by accident. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for NotifyIcon (the notification-area icon); WPF has none of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AsterLink.App</RootNamespace>
    <AssemblyName>AsterLink</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- The GUI always runs as the interactive user (asInvoker); privilege lives in the service. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The brand icon (generated from frontend/brand/mark.svg by frontend/scripts/brand-apps.mjs): the exe, the Start-menu entry, the taskbar, Alt+Tab and Apps & features all take it from here. -->
    <ApplicationIcon>Assets\AsterLink.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The window icon (MainWindow.xaml) and the three notification-area states (TrayIcon.cs). -->
    <Resource Include="Assets\AsterLink.ico" />
    <EmbeddedResource Include="Assets\tray-idle.ico" LogicalName="tray-idle.ico" />
    <EmbeddedResource Include="Assets\tray-live.ico" LogicalName="tray-live.ico" />
    <EmbeddedResource Include="Assets\tray-error.ico" LogicalName="tray-error.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both UI stacks define Application, Button, MessageBox...: keep them out of the implicit usings so every name means the WPF one. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AsterLink.Shared\AsterLink.Shared.csproj" />
    <ProjectReference Include="..\AsterLink.Platform\AsterLink.Platform.csproj" />
  </ItemGroup>

</Project>
