<UserControl x:Class="AsterLink.App.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="连接" Style="{StaticResource PageTitle}" />

        <!-- Status: one large line of text, a coloured disc, and exactly one primary action. -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="14" Height="14" Fill="{Binding ConnBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ConnStatus}" FontSize="26" FontWeight="SemiBold" Margin="12,0,0,0"
                               AutomationProperties.AutomationId="ConnectionState" />
                </StackPanel>
                <TextBlock Text="{Binding ConnDetail}" Margin="26,6,0,0" Style="{StaticResource Muted}"
                           Visibility="{Binding HasConnDetail, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.AutomationId="ConnectionDetail" />
                <ProgressBar IsIndeterminate="True" Margin="26,12,0,0" MaxWidth="320" HorizontalAlignment="Left"
                             Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}" />

                <Border Margin="0,16,0,0" Padding="14" CornerRadius="8" Background="{DynamicResource SelectedBrush}">
                    <StackPanel>
                        <TextBlock Text="当前线路" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding SelectedNodeText}" FontWeight="SemiBold" Margin="0,2,0,0"
                                   AutomationProperties.AutomationId="SelectedNode" />
                        <TextBlock Text="{Binding SelectedNodeRegion}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="连接" Style="{StaticResource PrimaryButton}" MinWidth="140"
                            Command="{Binding ConnectCommand}"
                            Visibility="{Binding ShowConnect, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.AutomationId="Connect" />
                    <Button Content="断开" MinWidth="140" Command="{Binding DisconnectCommand}"
                            Visibility="{Binding ShowDisconnect, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.AutomationId="Disconnect" />
                    <Button Content="取消连接" Margin="8,0,0,0" Command="{Binding CancelCommand}"
                            Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.AutomationId="CancelConnect" />
                </StackPanel>
                <TextBlock Text="取消连接会结束本次会话，需要重新登录。" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                           Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding DisabledReason}" Foreground="{DynamicResource WarnBrush}" Margin="0,10,0,0"
                           Visibility="{Binding ShowDisabledReason, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.AutomationId="DisabledReason" />
            </StackPanel>
        </Border>

        <!-- Plan: expiry, confirmed balance, and the way to buy or renew. -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <StackPanel Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <TextBlock Text="{Binding PlanName}" Style="{StaticResource SectionTitle}" AutomationProperties.AutomationId="PlanName" />
                        <TextBlock Text="{Binding PlanExpires}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding PlanUsedPercent, Mode=OneWay}" Margin="0,12,0,0"
                                 AutomationProperties.Name="已用流量比例" />
                    <TextBlock Text="{Binding PlanRemaining}" Style="{StaticResource Muted}" Margin="0,8,0,0"
                               AutomationProperties.AutomationId="PlanRemaining" />
                </StackPanel>
                <StackPanel Visibility="{Binding NoPlan, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="暂无可用套餐" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding NoPlanText}" Foreground="{DynamicResource WarnBrush}" Margin="0,6,0,0"
                               AutomationProperties.AutomationId="NoPlanText" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="购买 / 续费" Style="{StaticResource PrimaryButton}" Command="{Binding OpenPlansCommand}" />
                        <Button Content="我已购买，刷新" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Usage: rates from the Core, one small chart, estimated vs confirmed balance told apart. -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                Visibility="{Binding ShowMetering, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding UpSpeed}" FontWeight="SemiBold" AutomationProperties.AutomationId="UpSpeed" />
                    <TextBlock Text="{Binding DownSpeed}" FontWeight="SemiBold" Margin="24,0,0,0" AutomationProperties.AutomationId="DownSpeed" />
                    <TextBlock Text="{Binding RateText}" Style="{StaticResource Muted}" Margin="24,0,0,0" />
                </StackPanel>
                <Viewbox Height="48" Width="300" HorizontalAlignment="Left" Margin="0,12,0,0" Stretch="Fill"
                         AutomationProperties.Name="速率曲线">
                    <Canvas Width="300" Height="48">
                        <Polyline Points="{Binding DownPoints}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
                        <Polyline Points="{Binding UpPoints}" Stroke="{DynamicResource PassBrush}" StrokeThickness="2" StrokeDashArray="3 2" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="实线：下行　虚线：上行" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                <TextBlock Text="{Binding SessionTotals}" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding RemainingEstimate}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                <TextBlock Text="本线路由节点侧独立计量：套餐流量按节点实测的收发字节扣除，本机数值仅供参考。"
                           Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                           Visibility="{Binding ShowNodeMeteredNote, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
