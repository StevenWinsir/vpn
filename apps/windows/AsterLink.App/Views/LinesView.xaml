<UserControl x:Class="AsterLink.App.Views.LinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:AsterLink.App.Controls">
    <!-- Lines: search, line type, and the list grouped by region (server order kept inside each region). -->
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid MaxWidth="420" HorizontalAlignment="Left" MinWidth="220">
                <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" Padding="34,0,34,0"
                         ui:Ui.Placeholder="搜索线路或地区" AutomationProperties.AutomationId="NodeSearch" AutomationProperties.Name="搜索线路或地区" />
                <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconSearch}" Width="16" Height="16" HorizontalAlignment="Left" Margin="12,0,0,0"
                                Foreground="{DynamicResource TextTertiaryBrush}" IsHitTestVisible="False" />
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,4,0" Width="28" Height="28" MinHeight="28"
                        Click="OnClearSearch" Visibility="{Binding Search, Converter={StaticResource TextToVisibility}}"
                        AutomationProperties.Name="清除搜索" ToolTip="清除搜索" AutomationProperties.AutomationId="ClearSearch">
                    <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconX}" Width="14" Height="14" />
                </Button>
            </Grid>
            <Border Grid.Column="1" Style="{StaticResource SegmentHost}" Margin="16,0,0,0" VerticalAlignment="Center"
                    AutomationProperties.Name="线路类型">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="全部" Style="{StaticResource Segment}" GroupName="lineFilter" IsChecked="{Binding FilterAll}" AutomationProperties.AutomationId="FilterAll" />
                    <RadioButton Content="专线" Style="{StaticResource Segment}" GroupName="lineFilter" IsChecked="{Binding FilterDedicated}" AutomationProperties.AutomationId="FilterDedicated" />
                    <RadioButton Content="普通线路" Style="{StaticResource Segment}" GroupName="lineFilter" IsChecked="{Binding FilterDirect}" AutomationProperties.AutomationId="FilterDirect" />
                </StackPanel>
            </Border>
        </Grid>

        <ui:NoticeBar Text="{Binding NodesHint}" Kind="info" Margin="0,16,0,0" AutomationProperties.AutomationId="NodesHint" />

        <!-- Empty states: what is missing and the one step that helps. -->
        <ContentControl Style="{StaticResource Card}" Margin="0,16,0,0" Padding="24,40"
                        Visibility="{Binding ShowNodesEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center">
                <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconWorld}" Width="36" Height="36" Foreground="{DynamicResource TextTertiaryBrush}"
                                HorizontalAlignment="Center" />
                <TextBlock Text="{Binding NodesEmptyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0"
                           AutomationProperties.AutomationId="NodesEmpty" />
                <Button Content="购买套餐" Style="{StaticResource PrimaryButton}" Command="{Binding OpenPlansCommand}" HorizontalAlignment="Center" Margin="0,16,0,0"
                        ui:Ui.Icon="{StaticResource IconExternalLink}" Visibility="{Binding NodesEmptyBuy, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="清除筛选" Command="{Binding ClearFilterCommand}" HorizontalAlignment="Center" Margin="0,16,0,0"
                        Visibility="{Binding NodesEmptyClear, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="ClearFilter" />
                <Button Content="刷新" Command="{Binding RefreshCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" ui:Ui.Icon="{StaticResource IconRefresh}"
                        Visibility="{Binding NodesEmptyRefresh, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ContentControl>

        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" AutomationProperties.AutomationId="NodeList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,20,0,0">
                        <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
                            <TextBlock Text="{Binding Region}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Faint}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ContentControl Style="{StaticResource Card}" Padding="6">
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowButton}" Margin="0,1"
                                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}" AutomationProperties.Name="{Binding SpokenName}">
                                            <Border x:Name="Row" Padding="12,10" CornerRadius="8" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Selection is a mark AND the word "已选", never colour alone. -->
                                                    <Ellipse x:Name="Empty" Width="18" Height="18" Stroke="{DynamicResource StrokeStrongBrush}" StrokeThickness="1.5"
                                                             HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                    <ContentControl x:Name="Mark" Style="{StaticResource Icon}" Tag="{StaticResource IconCircleCheck}" Width="20" Height="20"
                                                                    Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Left" Visibility="Collapsed" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                        <TextBlock x:Name="SelectedLabel" Text="已选" Visibility="Collapsed" Margin="0,0,12,0"
                                                                   Foreground="{DynamicResource BrandBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Border Style="{StaticResource LineTag}" Tag="{Binding IsDedicated}" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding LineLabel}" TextWrapping="NoWrap" />
                                                        </Border>
                                                        <TextBlock Text="{Binding RateText}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="NoWrap"
                                                                   MinWidth="86" TextAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Empty" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="SelectedLabel" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ContentControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
