<UserControl x:Class="AsterLink.App.Views.NodesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid>
            <TextBlock Text="线路" Style="{StaticResource PageTitle}" />
            <Button Content="刷新" Command="{Binding RefreshCommand}" HorizontalAlignment="Right"
                    AutomationProperties.AutomationId="RefreshNodes" />
        </Grid>
        <TextBlock Text="线路由管理员在网站配置，修改后会自动同步到这里。这里不提供配置文件或订阅导出。"
                   Style="{StaticResource Muted}" Margin="0,6,0,0" />

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"
                     AutomationProperties.AutomationId="NodeSearch" AutomationProperties.Name="搜索线路（名称、地区、类型）" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <RadioButton Content="全部" Style="{StaticResource Segment}" GroupName="lineFilter" IsChecked="{Binding FilterAll}" />
                <RadioButton Content="专线" Style="{StaticResource Segment}" GroupName="lineFilter" IsChecked="{Binding FilterDedicated}" />
                <RadioButton Content="普通线路" Style="{StaticResource Segment}" GroupName="lineFilter" IsChecked="{Binding FilterDirect}" />
            </StackPanel>
        </Grid>
        <TextBlock Text="{Binding NodesHint}" Foreground="{DynamicResource WarnBrush}" Margin="0,10,0,0"
                   Visibility="{Binding HasNodesHint, Converter={StaticResource BoolToVisibility}}" />

        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="8">
            <StackPanel>
                <TextBlock Text="{Binding NodesEmptyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,32"
                           Visibility="{Binding ShowNodesEmpty, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.AutomationId="NodesEmpty" />
                <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.AutomationId="NodeList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowButton}" Margin="0,2"
                                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Id}" AutomationProperties.Name="{Binding Name}">
                                <Border x:Name="Row" Padding="12,10" CornerRadius="8" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Selection is a mark AND the word "已选", never colour alone. -->
                                        <TextBlock x:Name="Mark" Text="○" FontSize="16" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Region}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="已选" x:Name="SelectedLabel" Visibility="Collapsed" Margin="0,0,12,0"
                                                       Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="已校验" x:Name="VerifiedLabel" Visibility="Collapsed" Margin="0,0,12,0"
                                                       Foreground="{DynamicResource PassBrush}" />
                                            <TextBlock Text="节点计量" Visibility="{Binding NodeMetered, Converter={StaticResource BoolToVisibility}}"
                                                       Style="{StaticResource Muted}" Margin="0,0,12,0" />
                                            <Border Padding="8,2" CornerRadius="10" Background="{DynamicResource ButtonBrush}" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding LineLabel}" FontWeight="SemiBold" FontSize="12" />
                                            </Border>
                                            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center">
                                                <Run Text="流量 " /><Run Text="{Binding RateLabel, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Selected}" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                    <Setter TargetName="Mark" Property="Text" Value="●" />
                                    <Setter TargetName="SelectedLabel" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConfigVerified}" Value="True">
                                    <Setter TargetName="VerifiedLabel" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
