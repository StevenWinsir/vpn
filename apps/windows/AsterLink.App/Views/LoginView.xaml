<UserControl x:Class="AsterLink.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="400" Margin="0,40,0,40" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="AsterLink" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"
                       AutomationProperties.AutomationId="Title" />
            <TextBlock Text="登录后同步您的套餐与线路" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,24" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="邮箱" FontWeight="SemiBold" />
                    <TextBox x:Name="EmailBox" Margin="0,6,0,0" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="Email" AutomationProperties.Name="邮箱"
                             IsEnabled="{Binding LoginEnabled}" />
                    <TextBlock Text="密码" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <PasswordBox x:Name="PasswordBox" Margin="0,6,0,0" MaxLength="72"
                                 AutomationProperties.AutomationId="Password" AutomationProperties.Name="密码"
                                 IsEnabled="{Binding LoginEnabled}" />
                    <CheckBox Content="记住密码（保存在本机 Windows 凭据管理器）" Margin="0,16,0,0"
                              IsChecked="{Binding RememberPassword}" IsEnabled="{Binding LoginEnabled}"
                              AutomationProperties.AutomationId="Remember" />

                    <Button x:Name="SubmitButton" Content="{Binding LoginButtonText}" Style="{StaticResource PrimaryButton}"
                            Margin="0,20,0,0" IsDefault="True" IsEnabled="{Binding LoginEnabled}"
                            Click="OnSubmit" AutomationProperties.AutomationId="Login" />

                    <TextBlock Text="{Binding StartingText}" Style="{StaticResource Muted}" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding LoginMessage}" Foreground="{DynamicResource FailBrush}" Margin="0,12,0,0"
                               Visibility="{Binding HasLoginMessage, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.AutomationId="LoginMessage" />
                    <TextBlock Text="{Binding LoginWarning}" Foreground="{DynamicResource WarnBrush}" Margin="0,8,0,0"
                               Visibility="{Binding HasLoginWarning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- First-run / repair: the one action that helps, shown only while the privileged service is not ready. -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="{Binding ShowServiceCard, Converter={StaticResource BoolToVisibility}}">
                <StackPanel DataContext="{Binding Service}">
                    <TextBlock Text="{Binding State}" Style="{StaticResource SectionTitle}"
                               AutomationProperties.AutomationId="ServiceState" />
                    <TextBlock Text="{Binding Message}" Margin="0,6,0,0" AutomationProperties.AutomationId="ServiceMessage" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" Style="{StaticResource PrimaryButton}"
                                Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.AutomationId="ServiceAction" />
                        <Button Content="重新检测" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                                AutomationProperties.AutomationId="ServiceRefresh" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="注册账号" Style="{StaticResource LinkButton}" Command="{Binding OpenRegisterCommand}" />
                <Button Content="忘记密码" Style="{StaticResource LinkButton}" Command="{Binding OpenForgotPasswordCommand}"
                        AutomationProperties.AutomationId="ForgotPassword" />
                <Button Content="购买套餐" Style="{StaticResource LinkButton}" Command="{Binding OpenPlansCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
