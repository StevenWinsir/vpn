<UserControl x:Class="AsterLink.App.Controls.ServiceGuide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:AsterLink.App.Controls">
    <!-- The background service guide (handoff 6.5): one reason, one primary action (install / start / repair, each through
         the existing elevation flow), and "重新检测". DataContext is the ServicePanel. -->
    <Border CornerRadius="12" BorderThickness="1" Padding="18,16" Background="{DynamicResource WarnBackgroundBrush}" BorderBrush="{DynamicResource WarnBorderBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Top">
                <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconShieldCheck}" Width="18" Height="18" HorizontalAlignment="Center"
                                Foreground="{DynamicResource WarnTextBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock Text="{Binding State}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                           AutomationProperties.AutomationId="ServiceState" />
                <TextBlock Text="{Binding Message}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"
                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="ServiceMessage" />
                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource WarnTextBrush}" Margin="0,6,0,0"
                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="ServiceDetail" />
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="ServiceAction" />
                    <Button Content="重新检测" Command="{Binding RefreshCommand}" ui:Ui.Icon="{StaticResource IconRefresh}"
                            AutomationProperties.AutomationId="ServiceRefresh" />
                </WrapPanel>
                <ProgressBar IsIndeterminate="True" Margin="0,12,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="正在处理" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
