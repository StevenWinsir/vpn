<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that calls Win32 (named pipes, SCM, Job Objects, tokens, ACLs) lives here so the
       pure policy in AsterLink.Shared stays testable on any OS. Same OS floor as the GUI and service. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>AsterLink.Platform</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AsterLink.Shared\AsterLink.Shared.csproj" />
  </ItemGroup>

</Project>
