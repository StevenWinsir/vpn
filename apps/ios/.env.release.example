# Public build parameters of a RELEASE build (scripts/package-native-ios.py reads this unless
# --env-file says otherwise). Same three keys as .env.example; APP_ENV=release makes the build
# refuse anything but HTTPS (shared/contracts/env-v1.json). Never put secrets here.
APP_ENV=release
API_BASE_URL=https://demo.hyshentou.cn/api/v1/client
WEBSITE_BASE_URL=https://test.hyshentou.cn
