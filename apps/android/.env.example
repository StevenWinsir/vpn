# Public build parameters only. Never put passwords, tokens, database or node secrets here.
# Read by the Android Gradle build at BUILD time (build-logic ClientEnv, the same rules as
# scripts/native_env.py and shared/contracts/env-v1.json), validated, and baked into the
# signed APK as BuildConfig constants; editing it later does not change an installed app.
# Copy to apps/android/.env to override. A local backend is reached with
# `adb reverse tcp:8080 tcp:8080` and http://127.0.0.1:8080/api/v1/client (development only).
APP_ENV=development
API_BASE_URL=https://demo.hyshentou.cn/api/v1/client
WEBSITE_BASE_URL=https://test.hyshentou.cn
