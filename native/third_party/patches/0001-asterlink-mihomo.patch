+// AsterLinkRejectPatchVersion is a build-time guard: the client meters TotalTraffic(true)
+// and must not bill bytes that a REJECT or REJECT-DROP outbound discarded.
+const AsterLinkRejectPatchVersion = 1
+
+// asterLinkBilled reports whether bytes on a chain ending at lastChain count as proxy
+// traffic. DIRECT never left through the proxy; REJECT and REJECT-DROP never left at all
+// (their connections accept writes and discard them), so neither may reach the proxy totals.
+func asterLinkBilled(lastChain string) bool {
+	switch lastChain {
+	case "DIRECT", "REJECT", "REJECT-DROP":
+		return false
+	}
+	return true
+}
