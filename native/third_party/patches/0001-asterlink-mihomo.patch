+package statistic
+
+import "testing"
+
+// AsterLink bills Manager.TotalTraffic(true). Bytes a REJECT outbound swallowed never
+// left the device and must not be billed; DIRECT stays excluded; any proxy counts.
+func TestAsterLinkRejectIsNotBilled(t *testing.T) {
+	m := &Manager{}
+	m.PushUploaded("node", 100)
+	m.PushDownloaded("node", 1000)
+	m.PushUploaded("REJECT", 7)
+	m.PushDownloaded("REJECT", 70)
+	m.PushUploaded("REJECT-DROP", 9)
+	m.PushDownloaded("REJECT-DROP", 90)
+	m.PushUploaded("DIRECT", 11)
+	m.PushDownloaded("DIRECT", 110)
+
+	up, down := m.TotalTraffic(true)
+	if up != 100 || down != 1000 {
+		t.Fatalf("proxy totals = %d/%d, want 100/1000 (only the node)", up, down)
+	}
+	up, down = m.TotalTraffic(false)
+	if up != 127 || down != 1270 {
+		t.Fatalf("all totals = %d/%d, want 127/1270 (every chain)", up, down)
+	}
+}
+
+func TestAsterLinkBilledChains(t *testing.T) {
+	for chain, want := range map[string]bool{
+		"node": true, "DIRECT": false, "REJECT": false, "REJECT-DROP": false,
+		// Only the exact built-in names are excluded: a proxy that merely contains the word is billed.
+		"REJECT-node": true, "reject": true, "": true,
+	} {
+		if got := asterLinkBilled(chain); got != want {
+			t.Errorf("asterLinkBilled(%q) = %v, want %v", chain, got, want)
+		}
+	}
+}
