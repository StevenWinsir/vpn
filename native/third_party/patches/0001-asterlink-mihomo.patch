+package sing_tun
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"runtime/pprof"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	LC "github.com/metacubex/mihomo/listener/config"
+	"github.com/metacubex/mihomo/tunnel"
+	tun "github.com/metacubex/sing-tun"
+)
+
+func natLoops() int {
+	var profile bytes.Buffer
+	_ = pprof.Lookup("goroutine").WriteTo(&profile, 1)
+	total := 0
+	for _, block := range strings.Split(profile.String(), "\n\n") {
+		if !strings.Contains(block, "TCPNat).loopCheckTimeout") {
+			continue
+		}
+		for _, line := range strings.Split(block, "\n") {
+			if count, _, ok := strings.Cut(line, " @ "); ok {
+				n, _ := strconv.Atoi(count)
+				total += n
+			}
+		}
+	}
+	return total
+}
+
+func waitNAT(t *testing.T, want int) {
+	t.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		if natLoops() == want {
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatalf("TCPNat.loopCheckTimeout: got %d, want %d", natLoops(), want)
+}
+
+// Real pinned sing-tun NAT workers, not goroutines manufactured by this test.
+// No TUN device, route, driver or privileged operation is needed on any OS.
+func TestAsterLinkListenerCloseStopsNAT(t *testing.T) {
+	baseline := natLoops()
+	for cycle := 0; cycle < 20; cycle++ {
+		ctx, cancel := context.WithCancel(context.Background())
+		t.Cleanup(cancel)
+		l := &Listener{cancel: cancel}
+		_ = tun.NewNat(ctx, time.Hour)
+		waitNAT(t, baseline+1)
+		if err := l.Close(); err != nil {
+			t.Fatal(err)
+		}
+		waitNAT(t, baseline)
+	}
+}
+
+type contextCloser struct {
+	ctx context.Context
+	err error
+}
+
+func (c *contextCloser) Start() error { return nil }
+func (c *contextCloser) Close() error {
+	if c.ctx.Err() != context.Canceled {
+		panic("listener must cancel before stack Close")
+	}
+	return c.err
+}
+
+func TestAsterLinkCancelEvenWhenCloseFails(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	want := errors.New("stack close failed")
+	l := &Listener{cancel: cancel, tunStack: &contextCloser{ctx: ctx, err: want}}
+	if err := l.Close(); !errors.Is(err, want) {
+		t.Fatalf("Close error = %v, want %v", err, want)
+	}
+	_ = l.Close()
+}
+
+// This post-allocation error uses an explicit nil return. The defer must close
+// the allocated listener, not dereference the overwritten named return value.
+func TestAsterLinkNewFailureClosesAllocatedListener(t *testing.T) {
+	if !supportRedirect {
+		t.Skip("auto-redirect validation exists only on Linux")
+	}
+	l, err := New(LC.Tun{AutoRedirect: true, Device: "asterlink-unit"}, tunnel.Tunnel)
+	if err == nil || l != nil {
+		t.Fatalf("New = %v, %v; want nil listener and error", l, err)
+	}
+}
