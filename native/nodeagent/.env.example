# AsterLink node agent settings. Copy to a root-owned file (mode 0600) and pass it with
#   asterlink-nodeagent -env /etc/asterlink/nodeagent.env
# Process environment variables with the same names override this file. These are not
# shell variables: no quoting rules, no $-interpolation, no duplicate keys.

# --- control plane (backend NODE_AGENT_ADDR listener, mTLS) ---
NODEAGENT_API_URL=https://demo.hyshentou.cn:8443
# This node's client certificate. Register its fingerprint in the admin console:
#   asterlink-nodeagent -env /etc/asterlink/nodeagent.env -print-fingerprint
NODEAGENT_CLIENT_CERT_FILE=/etc/asterlink/agent-client.pem
NODEAGENT_CLIENT_KEY_FILE=/etc/asterlink/agent-client.key
# Optional private CA that signed the control plane's server certificate.
NODEAGENT_SERVER_CA_FILE=

# --- durable state (epoch, report cursors, checkpoints); keep it on persistent disk ---
NODEAGENT_STATE_FILE=/var/lib/asterlink/nodeagent-state.json

# --- the forwarder this agent controls ---
NODEAGENT_VLESS_LISTEN=0.0.0.0:443
NODEAGENT_VLESS_TLS_CERT_FILE=/etc/asterlink/vless.pem
NODEAGENT_VLESS_TLS_KEY_FILE=/etc/asterlink/vless.key
# Tests only. A public node must not serve plaintext or reach private networks.
NODEAGENT_ALLOW_PLAINTEXT=false
NODEAGENT_ALLOW_PRIVATE_TARGETS=false

# --- cadence (seconds) ---
# Revocation latency is about one sync interval; keep it well below the grant lease.
NODEAGENT_SYNC_SECONDS=2
NODEAGENT_USAGE_SECONDS=5
