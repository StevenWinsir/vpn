APP_ENV=development
# Same-host reverse proxy: keep loopback. Container/cross-host private ingress:
# set HTTP_ADDR=0.0.0.0:8080 (or a private interface) and restrict firewall sources.
HTTP_ADDR=127.0.0.1:8080
REQUEST_TIMEOUT_SECONDS=60
MIGRATION_TIMEOUT_SECONDS=180
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=clash
DATABASE_USER=clash
DATABASE_PASSWORD=replace-me
DATABASE_SCHEMA=vpn_app
DATABASE_SSLMODE=verify-full
DATABASE_SSLROOTCERT=
DATABASE_MAX_OPEN=10
DATABASE_MAX_IDLE=3
AUTO_MIGRATE=false
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=asterlink-api
JWT_AUDIENCE=asterlink-clients
ACCESS_TOKEN_MINUTES=15
SESSION_HOURS=12
REMEMBER_DAYS=30
# HTTPS deployment: COOKIE_SECURE=true. Current cookies are HttpOnly + SameSite=Lax.
# Different unrelated domains/IPs need a same-origin reverse proxy; CORS alone is not enough.
COOKIE_SECURE=false
# EXACT browser frontend origin: scheme + hostname + optional port, no trailing slash.
# Example: ALLOWED_ORIGINS=https://app.example.com
ALLOWED_ORIGINS=http://localhost:3000
TEST_PURCHASE_ENABLED=false
BCRYPT_COST=12
AUTH_REQUESTS_PER_MINUTE=20
API_REQUESTS_PER_MINUTE=180

# Private directory containing <plan_id>.yaml, e.g. /etc/asterlink/client-profiles/pro.yaml.
# Never put these files under frontend/public or a public Nginx directory.
# Empty/unavailable configuration denies client profile downloads.
CLIENT_PROFILE_DIR=
# Development/test only; paid_test orders do NOT authorize native VPN access by default.
# Production rejects true. TEST_PURCHASE_ENABLED must also be true for test entitlements.
CLIENT_ALLOW_TEST_ENTITLEMENTS=false

# Development node catalog replaces private plan files when enabled. No file fallback.
# Production rejects both catalog delivery and CLIENT_PROFILE_DIR until node-side
# metering and per-user credential revocation are implemented and deployed.
CLIENT_NODE_CATALOG_ENABLED=false
# Generate once with: openssl rand -base64 32. Back up securely; changing it requires re-encryption.
NODE_ENCRYPTION_KEY=
