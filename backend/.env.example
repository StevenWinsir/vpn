APP_ENV=development
# Same-host reverse proxy: keep loopback. Container/cross-host private ingress:
# set HTTP_ADDR=0.0.0.0:8080 (or a private interface) and restrict firewall sources.
HTTP_ADDR=127.0.0.1:8080
REQUEST_TIMEOUT_SECONDS=60
MIGRATION_TIMEOUT_SECONDS=180
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=clash
DATABASE_USER=clash
DATABASE_PASSWORD=replace-me
DATABASE_SCHEMA=vpn_app
DATABASE_SSLMODE=verify-full
DATABASE_SSLROOTCERT=
DATABASE_MAX_OPEN=10
DATABASE_MAX_IDLE=3
AUTO_MIGRATE=false
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=asterlink-api
JWT_AUDIENCE=asterlink-clients
ACCESS_TOKEN_MINUTES=15
SESSION_HOURS=12
REMEMBER_DAYS=30
# HTTPS deployment: COOKIE_SECURE=true. Current cookies are HttpOnly + SameSite=Lax.
# Different unrelated domains/IPs need a same-origin reverse proxy; CORS alone is not enough.
COOKIE_SECURE=false
# EXACT browser frontend origin: scheme + hostname + optional port, no trailing slash.
# Example: ALLOWED_ORIGINS=https://app.example.com
ALLOWED_ORIGINS=http://localhost:3000
TEST_PURCHASE_ENABLED=false
BCRYPT_COST=12
AUTH_REQUESTS_PER_MINUTE=20
API_REQUESTS_PER_MINUTE=180

# Private directory containing <plan_id>.yaml, e.g. /etc/asterlink/client-profiles/pro.yaml.
# Never put these files under frontend/public or a public Nginx directory.
# Empty/unavailable configuration denies client profile downloads.
CLIENT_PROFILE_DIR=
# Development/test only; paid_test orders do NOT authorize native VPN access by default.
# Production rejects true. TEST_PURCHASE_ENABLED must also be true for test entitlements.
CLIENT_ALLOW_TEST_ENTITLEMENTS=false

# Development node catalog replaces private plan files when enabled. No file fallback.
# Production rejects CLIENT_PROFILE_DIR outright. It accepts the catalog only together with
# the node-agent listener below: delivery then goes through per-user grants that the node
# itself confirms and meters. Client-reported /config and /traffic are refused in production.
CLIENT_NODE_CATALOG_ENABLED=false
# Generate once with: openssl rand -base64 32. Back up securely; changing it requires re-encryption.
NODE_ENCRYPTION_KEY=

# Native client protocol timings (seconds). Defaults reproduce the original fixed values.
# Required: REPORT_INTERVAL < LEASE <= IDLE_TIMEOUT, and NODE_WATCH < LEASE.
# The API returns the effective values to clients; clients never hard-code them.
CLIENT_REPORT_INTERVAL_SECONDS=60
CLIENT_LEASE_SECONDS=90
CLIENT_IDLE_TIMEOUT_SECONDS=180
CLIENT_NODE_WATCH_SECONDS=5

# Online devices and node groups. A device is online while it holds a connection lease
# (length CLIENT_LEASE_SECONDS, renewed by its normal reports). The effective per-user cap
# is min(subscription max_devices, CLIENT_MAX_ONLINE_DEVICES) (1-100).
CLIENT_MAX_ONLINE_DEVICES=2
# A server enters a soft cooldown when this many DIFFERENT users report it failing within
# 5 minutes (2-50); the cooldown lasts NODE_HEALTH_COOLDOWN_SECONDS (60-3600).
NODE_HEALTH_FAILURE_USERS=3
NODE_HEALTH_COOLDOWN_SECONDS=300

# --- Authoritative (node-reported) metering: node-agent mTLS listener -------------------
# Setting NODE_AGENT_ADDR starts a SECOND listener, separate from HTTP_ADDR, that only
# accepts connections presenting a client certificate chained to NODE_AGENT_CLIENT_CA_FILE
# (and pinned per node in the admin console). Bind it to a private/firewalled interface.
# Leave empty to disable. The three files are required whenever the address is set.
NODE_AGENT_ADDR=
NODE_AGENT_TLS_CERT_FILE=
NODE_AGENT_TLS_KEY_FILE=
NODE_AGENT_CLIENT_CA_FILE=
# An agent not heard from within this many seconds cannot issue new grants (5-300).
NODE_AGENT_STALE_SECONDS=30
# A grant whose node never confirmed removal is released this long after its absolute
# deadline, when the node has certainly stopped forwarding on its own (10-3600).
NODE_AGENT_SETTLE_GRACE_SECONDS=60
# Raw-byte allowance handed to a node per grant and per top-up (1 MiB - 64 GiB).
# Bounds how far a user can overshoot their quota between node reports.
GRANT_BUDGET_BYTES=536870912
# Clients older than this (dotted numeric, e.g. 1.2.0) cannot create grants. Empty = no minimum.
CLIENT_MIN_APP_VERSION=

# --- Registration and mail (handoff_auth.md 3.1) -----------------------------------------
# Backend-only. Never put these in frontend env files, client builds, logs or Git.
# ALLOW_REGISTRATION: strict true/false, default false. true REQUIRES the complete SMTP
# group, WEBSITE_BASE_URL and AUTH_MAIL_SECRET, otherwise the API refuses to start.
# Turning it off still allows existing users to log in and recover their password.
ALLOW_REGISTRATION=false
# Leave all SMTP_* empty to run without mail (no registration, no reset mail). A partial
# SMTP group is a startup error. QQ Mail: implicit TLS on 465; the password is the SMTP
# authorization code (授权码), NOT the QQ login password. SMTP_SECURE=false means
# mandatory STARTTLS (for example port 587), never plaintext.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
# Complete sender mailbox, e.g. xxxx@qq.com; also the From address.
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=AsterLink VPN
# Root origin of the website used in reset links, e.g. https://app.example.com
# (no path, query or fragment). Production requires HTTPS; plain HTTP only for loopback.
# Must point at the same environment as the clients' WEBSITE_BASE_URL build setting.
WEBSITE_BASE_URL=
# Independent high-entropy key for code/token digests and mail payload encryption.
# Generate once with: openssl rand -base64 32 . Identical on every API instance.
# Not the JWT secret or node key. Rotating it invalidates unfinished codes and links.
AUTH_MAIL_SECRET=
# Exact domains allowed for NEW registrations only (default: qq.com, foxmail.com,
# 163.com, 126.com, yeah.net, gmail.com, outlook.com, hotmail.com, icloud.com, yahoo.com).
# Comma separated; no wildcards or subdomain matching. Setting it to an empty value is a
# startup error, so keep the line commented out to use the default list.
# REGISTRATION_ALLOWED_EMAIL_DOMAINS=qq.com,gmail.com
# Reverse proxies allowed to supply X-Forwarded-For (IPs or CIDRs, comma separated).
# Empty = trust none: the TCP peer is the client address. Only list the hosts that
# overwrite client-supplied forwarding headers, and firewall the API port from others.
# Same-host Nginx -> Next.js -> Go: 127.0.0.1 together with CLIENT_IP_HEADER in frontend/.env
# and Nginx overwriting X-Forwarded-For on BOTH vhosts (docs/deployment.md "真实来源地址").
TRUSTED_PROXIES=

# --- Payment gateway (handoff_payment_account.md 4; 支付接入技术文档.md) ----------------------
# Backend-only. Never put these in frontend env files, client builds, logs or Git.
# PAYMENT_ENABLED=true REQUIRES PAYMENT_CHANNEL, PAYMENT_SECRET, PAYMENT_NOTIFY_URL and
# WEBSITE_BASE_URL (the result page is WEBSITE_BASE_URL/pay/result). With false the website
# keeps the development test purchase and the payment API answers 503 payment_disabled.
PAYMENT_ENABLED=false
# Gateway root origin (HTTPS; plain HTTP only outside production).
PAYMENT_GATEWAY_URL=https://pay.hyshentou.cn
# Merchant number (channel) and secret from the gateway operator. The gateway signature is
# MD5(trade_no + secret); it does NOT cover the amount, so amounts are checked on callback.
PAYMENT_CHANNEL=
PAYMENT_SECRET=
# Absolute callback URL the gateway POSTs to, normally https://<api domain>/api/v1/payments/notify.
PAYMENT_NOTIFY_URL=
# Gateway callback source addresses (IPs or CIDRs, comma separated). The callback carries no
# signature, so only these sources may fulfil an order automatically. Leave EMPTY at first:
# every callback then waits for manual review and the admin order detail shows its source
# address; put that address here and restart (handoff_payment_account.md 15.2 U-01/U-02).
# The real source is only visible when TRUSTED_PROXIES and Nginx are set up as in
# docs/deployment.md "真实来源地址".
PAYMENT_NOTIFY_ALLOWED_IPS=
# The gateway adds 0.01 for every unexpired order with the same amount; a callback may pay
# up to this much over the order (0-500 cents). Less than the order is never accepted.
PAYMENT_AMOUNT_TOLERANCE_CENTS=50
# Live unpaid orders per user (1-20) and the local window of one order (120-600 seconds;
# the gateway itself cancels an unpaid order after 2 minutes).
PAYMENT_MAX_PENDING_PER_USER=5
PAYMENT_PENDING_LIMIT_SECONDS=180
# Test price: REAL gateway payments at this price (yuan, 0.01-1000.00), for the listed
# accounts only. Production requires a non-empty list; an empty list in development means
# every account. Orders are marked price_source=test_price.
PAYMENT_TEST_PRICE_ENABLED=false
PAYMENT_TEST_PRICE=0.01
PAYMENT_TEST_PRICE_EMAILS=

# --- Login records: IP location (handoff_payment_account.md 8) --------------------------------
# Optional. A login only stores its IP; a background worker looks the location up later, so a
# slow or broken service never slows a login. Only the IP address is sent to the service. If
# you pick a service outside your region, mention it in your privacy policy. Empty = no lookup
# (records show "未解析"). Private, loopback and link-local addresses are never sent out.
# The template must contain {ip} exactly once, in the path or query (never the host), and be
# HTTPS in production. The reply must be JSON with country/region/city/isp style fields (ip-api,
# ipapi.co, ipwho.is and similar are understood). Example: https://ipwho.is/{ip}?lang=zh-CN
GEOIP_LOOKUP_URL=
# Optional bearer token, sent only in the Authorization header and never logged.
GEOIP_LOOKUP_TOKEN=
# Outbound lookups per minute for each API process (1-600).
GEOIP_REQUESTS_PER_MINUTE=30
