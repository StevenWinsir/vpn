# Next.js SERVER ONLY. Browser requests always use the frontend origin + /api/v1.
# Default works when Next.js and Go run on the same host (not separate Docker containers).
API_INTERNAL_URL=http://127.0.0.1:8080/api/v1
# Proxy timeout; the browser receives this value + 5000 ms from /api/runtime-config.
API_TIMEOUT_MS=65000
# Node list auto-refresh while visible, in ms (5000–300000; invalid values use 30000).
NODE_LIST_REFRESH_MS=30000
# Optional: request header in which the trusted reverse proxy in front of Next.js passes the browser
# address (e.g. X-Real-IP, which Nginx must OVERWRITE with $remote_addr). Next.js forwards exactly one
# valid IP from it to Go as X-Forwarded-For; Go only accepts it from TRUSTED_PROXIES. Leave empty when
# Next.js is reachable without that proxy. See docs/deployment.md "真实来源地址".
CLIENT_IP_HEADER=
# After changing the above values, restart Next.js and reload the page; no rebuild needed.
# NEXT_PUBLIC_API_URL and API_BASE_URL are no longer used. Never publish an internal URL.
# All NEXT_PUBLIC variables are public and build-time. NEVER put secrets here.
NEXT_PUBLIC_APP_NAME=AsterLink

# Android client download (/download). SERVER ONLY, read on every request: restart Next.js after
# editing, no rebuild. scripts/package-native-android.py prints these lines for each release
# (artifacts/native-android/release-private/website-env.txt). Upload the APK to the URL first.
# Leave ANDROID_APK_URL empty to show "not published yet". Never put the signing key or its password here.
ANDROID_APK_URL=
ANDROID_APK_VERSION=
ANDROID_APK_SHA256=
ANDROID_APK_SIZE_BYTES=
ANDROID_CERT_SHA256=
# Optional: where THIRD_PARTY_LICENSES.txt, SOURCE.txt and the source archives of the release are published.
ANDROID_SOURCE_URL=

# iPhone client download (/download). SERVER ONLY, read on every request. scripts/ios/resign-ipa.py prints
# these lines when it signs an IPA with --ipa-url. Upload the signed IPA and manifest.plist over HTTPS first
# (over-the-air install refuses plain http). Leave IOS_IPA_URL empty to show "not published yet".
# Only Ad Hoc (registered devices) and Enterprise signing can be installed this way. Never put a certificate,
# profile or password here.
IOS_IPA_URL=
IOS_MANIFEST_URL=
IOS_IPA_VERSION=
IOS_IPA_SHA256=
IOS_IPA_SIZE_BYTES=
IOS_SOURCE_URL=
