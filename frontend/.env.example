# Next.js SERVER ONLY. Browser requests always use the frontend origin + /api/v1.
# Default works when Next.js and Go run on the same host (not separate Docker containers).
API_INTERNAL_URL=http://127.0.0.1:8080/api/v1
# Proxy timeout; the browser receives this value + 5000 ms from /api/runtime-config.
API_TIMEOUT_MS=65000
# Node list auto-refresh while visible, in ms (5000–300000; invalid values use 30000).
NODE_LIST_REFRESH_MS=30000
# Dashboard online devices + 24-hour history refresh while visible, in ms (5000–120000; invalid values use 15000).
DASHBOARD_REFRESH_MS=15000
# Optional: request header in which the trusted reverse proxy in front of Next.js passes the browser
# address (e.g. X-Real-IP, which Nginx must OVERWRITE with $remote_addr). Next.js forwards exactly one
# valid IP from it to Go as X-Forwarded-For; Go only accepts it from TRUSTED_PROXIES. Leave empty when
# Next.js is reachable without that proxy. See docs/deployment.md "真实来源地址".
CLIENT_IP_HEADER=
# After changing the above values, restart Next.js and reload the page; no rebuild needed.
# NEXT_PUBLIC_API_URL and API_BASE_URL are no longer used. Never publish an internal URL.
# All NEXT_PUBLIC variables are public and build-time. NEVER put secrets here.
NEXT_PUBLIC_APP_NAME=AsterLink

# Client downloads (/download, the home page cards, /guide) are no longer configured here: the
# administrator publishes them in the console under "客户端下载" and the website reads the backend's
# public list (30-second cache). See docs/client-downloads.md. The former ANDROID_APK_*, ANDROID_CERT_*,
# IOS_IPA_*, IOS_MANIFEST_URL and *_SOURCE_URL lines can be deleted from an existing .env.

# Search engines (handoff_seo.md D1). SERVER ONLY, read on every request: restart Next.js after editing, no
# rebuild. The site is indexed only when SITE_INDEXING=on AND SITE_URL is a valid origin; anything else
# (including leaving both empty) keeps every page noindex, robots.txt at "Disallow: /" and sitemap.xml
# empty, so local, CI and preview copies are never indexed. SITE_URL is the public origin the canonical
# addresses, robots.txt and sitemap.xml use, e.g. https://www.asterlink.vip (HTTPS, no path, the same
# value as the backend's WEBSITE_BASE_URL). A page requested under any other host name is served noindex,
# so the reverse proxy must pass the browser's Host header unchanged (proxy_set_header Host $http_host).
# The share cards (og:url, og:image, handoff_seo.md D14) and the structured data (JSON-LD, 6.2) also
# need SITE_URL, with or without indexing; without it a shared link shows the title and description
# only and the pages carry no structured data. Production: SITE_URL=https://www.asterlink.vip and
# SITE_INDEXING=on, in the order of docs/seo-operations.md section 2 (Nginx: docs/deployment.md).
# Rollback: remove SITE_INDEXING (or set it to off) and restart Next.js.
SITE_URL=
SITE_INDEXING=
# Optional search engine verification tags on the home page (D15); DNS verification needs none of them.
# Letters, digits, "_" and "-" only; anything else is ignored with one warning in the log.
SITE_VERIFICATION_GOOGLE=
SITE_VERIFICATION_BING=
SITE_VERIFICATION_BAIDU=

# Home page footer (optional). SERVER ONLY, read on every request: restart Next.js after editing, no rebuild.
# The ICP filing number links to https://beian.miit.gov.cn/; the address also appears in the FAQ.
# Leave empty to show neither.
SITE_ICP_RECORD=
SITE_SUPPORT_EMAIL=

# Online support chat (Crisp) on the signed-in user pages. SERVER ONLY, read on every request through
# /api/runtime-config: restart Next.js after editing, no rebuild. Empty: the default website
# 83336a84-ae9f-4345-ba1f-583c0790002d. "off": no chat at all (emergency switch). Any other value must be a
# Crisp website ID; anything invalid also disables the chat and logs one warning. SITE_SUPPORT_EMAIL above is
# shown when the chat cannot connect. See docs/deployment.md "在线客服".
CRISP_WEBSITE_ID=
