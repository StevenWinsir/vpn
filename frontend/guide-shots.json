{
  "about": "The usage guide's picture pick list (handoff_guide.md 7.1). Each shot names a scene of a native app's screenshot suite; npm run guide:images turns it into public/guide/<platform>/<name>.<hash>.webp and the manifest src/lib/guide-images.ts. crop is [x, y, width, height] in source pixels; width is the output width (never enlarged).",
  "sources": {
    "macos": "python3 scripts/test-native-macos.py --suite ui → artifacts/native-macos/<run>-ui (Debug preview, release look)",
    "windows": "python3 scripts/test-native-windows.py --suite ui on Windows, or the windows-ui-preview artifact of the Windows CI run",
    "android": "python3 scripts/test-native-android.py --suite ui → GuideScreenshotTest guide-*.png (release build facts)",
    "ios": "python3 scripts/test-native-ios.py --suite ui → artifacts/native-ios/ui/screenshots (status bar fixed at 9:41)"
  },
